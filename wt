#!/usr/bin/env bash
# wt — 多仓库 worktree helper（脚手架仓库自带，随 worktree 分发）
#
# 心智模型：当前这个脚手架 worktree 目录 = 一个「工作区」。
# wt 把注册表里选中的仓库，各开一个 worktree 到 ./repos/<名字>/，
# 分支统一用「工作区名」（= 本 worktree 目录名）。收工时 wt cleanup 一并拆除。
#
# 用法：
#   ./wt list                 列出注册表里所有可用仓库
#   ./wt add <名字> [名字...]  把这些仓库的 worktree 建到 ./repos/
#   ./wt cleanup [--force]     拆除本工作区所有子仓库 worktree **及它们的分支**
#                              （拆前自动跑各仓库的 `mise run teardown` 回收
#                               docker 等 per-worktree 外部资源；见 cmd_cleanup）
#                              分支判定 vs repos.toml 的 base：改动已并入 base → 删；
#                              还有未并入的提交 → 保留并告警（绝不动没合进去的活）。
set -euo pipefail

# 脚手架根 = 本脚本所在目录（每个 worktree 有自己的一份 wt）
SCAFFOLD_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY="$SCAFFOLD_ROOT/repos.toml"
REPOS_DIR="$SCAFFOLD_ROOT/repos"
STATE="$REPOS_DIR/.state"   # 每行: name<TAB>src_path<TAB>target<TAB>branch

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_ylw=$'\033[33m'; c_dim=$'\033[2m'; c_rst=$'\033[0m'
info() { printf '%s\n' "$*" >&2; }
warn() { printf '%s%s%s\n' "$c_ylw" "$*" "$c_rst" >&2; }
die()  { printf '%s%s%s\n' "$c_red" "$*" "$c_rst" >&2; exit 1; }

[ -f "$REGISTRY" ] || die "找不到注册表: $REGISTRY"

workspace_name() { printf '%s' "${WT_WS:-$(basename "$SCAFFOLD_ROOT")}"; }

# --- 极简 TOML 读取（表名 = 仓库名，扁平字段；POSIX awk，兼容 BSD/macOS） ---
toml_names() {
  awk '/^[ \t]*\[[^]]+\]/ { line=$0; sub(/^[ \t]*\[[ \t]*/,"",line); sub(/[ \t]*\].*/,"",line); print line }' "$REGISTRY"
}
toml_get() { # $1=repo  $2=key
  awk -v repo="$1" -v key="$2" '
    /^[ \t]*\[[^]]+\]/ { line=$0; sub(/^[ \t]*\[[ \t]*/,"",line); sub(/[ \t]*\].*/,"",line); inrepo=(line==repo); next }
    inrepo && $0 ~ ("^[ \t]*" key "[ \t]*=") {
      v=$0; sub(/^[^=]*=[ \t]*/,"",v); sub(/[ \t]*$/,"",v); sub(/^"/,"",v); sub(/"$/,"",v); print v; exit
    }' "$REGISTRY"
}

detect_base() { # $1=path -> 打印 base ref
  local p="$1" h
  h="$(git -C "$p" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null | sed 's#refs/remotes/##')" || true
  [ -n "$h" ] && { printf '%s' "$h"; return; }
  for c in origin/main origin/master; do
    git -C "$p" rev-parse --verify --quiet "$c" >/dev/null 2>&1 && { printf '%s' "$c"; return; }
  done
  git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null   # 兜底：当前分支
}

cmd_list() {
  local ws; ws="$(workspace_name)"
  info "${c_dim}工作区: ${ws}   （wt add 后分支名即为此）${c_rst}"
  local n p d
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    p="$(toml_get "$n" path)"; d="$(toml_get "$n" desc)"
    printf '  %s%-22s%s %s%s%s\n' "$c_grn" "$n" "$c_rst" "$c_dim" "${d:-$p}" "$c_rst"
  done < <(toml_names)
}

cmd_add() {
  [ "$#" -ge 1 ] || die "用法: wt add <名字> [名字...]"
  mkdir -p "$REPOS_DIR"; touch "$STATE"
  local ws; ws="$(workspace_name)"
  local n path base target
  for n in "$@"; do
    path="$(toml_get "$n" path)"
    [ -n "$path" ] || { warn "跳过 ${n}：注册表里没有此仓库（wt list 查看）"; continue; }
    [ -d "$path/.git" ] || git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || { warn "跳过 ${n}：$path 不是 git 仓库"; continue; }
    target="$REPOS_DIR/$n"
    if [ -e "$target" ]; then warn "跳过 ${n}：$target 已存在"; continue; fi
    base="$(toml_get "$n" base)"; [ -n "$base" ] || base="$(detect_base "$path")"
    # 先 fetch，保证 origin/* base 是远端最新；失败则明确告警（拿的是本地缓存）
    if ! git -C "$path" fetch --quiet origin 2>/dev/null; then
      warn "$n: git fetch 失败（离线？），base ${base} 用的是本地缓存，可能不是最新"
    fi
    if git -C "$path" show-ref --verify --quiet "refs/heads/$ws"; then
      info "$n: 复用已有分支 $ws"
      git -C "$path" worktree add "$target" "$ws" >/dev/null
    else
      info "$n: 新建分支 $ws (base ${base})"
      git -C "$path" worktree add -b "$ws" "$target" "$base" >/dev/null
    fi
    printf '%s\t%s\t%s\t%s\n' "$n" "$path" "$target" "$ws" >> "$STATE"
    printf '  %s✓ %s%s -> repos/%s\n' "$c_grn" "$n" "$c_rst" "$n"
  done
}

# 约定：若某仓库 dev 时会拉起 per-worktree 的外部资源（docker 容器/卷、云沙箱…），
# 它在自己的 mise 里定义一个名为 `teardown` 的任务来回收。这里在删 worktree 之前
# 调它一次。为什么必须「删之前、且在 worktree 目录内」跑：teardown 通常靠
# `git rev-parse --abbrev-ref HEAD` 算出 per-worktree 资源名（如 docker compose
# project `<repo>-<slug>`）；worktree 一旦删掉，分支上下文没了，就再也对不上、
# 只能靠人肉记住每个 slug 去清——正是 docker 泄漏的根因。
# 语义：best-effort。仅当仓库确有 teardown 任务才跑；失败只告警，不阻断 worktree
# 拆除（回收外部资源与拆 worktree 是两件事，前者不该把后者拖住）。
run_teardown() {
  local dir="$1" name="$2"
  [ -d "$dir" ] || return 0
  command -v mise >/dev/null 2>&1 || return 0
  mise -C "$dir" tasks ls 2>/dev/null | awk '{print $1}' | grep -qx teardown || return 0
  info "  ↳ ${name}: mise run teardown（回收 per-worktree 外部资源）"
  ( cd "$dir" && mise run teardown ) \
    || warn "$name: teardown 失败，可能有 docker 容器/卷等残留，需手动清理"
}

# 拆 worktree 之后清掉那个工作区分支。
#
# 为什么不能只删 worktree：分支是 wt add 建的（分支名 = 工作区名），不删的话源仓里会
# 积一堆「PR 早就合了、但本地分支没人删」的名字，下次同名工作区还会「复用已有分支」
# （cmd_add 的分支复用逻辑），于是新工作区带着旧分支的历史，很容易误判。
#
# 判定用 `git cherry <base> <branch>`：凡是在 base 里找不到等价补丁的提交会带 `+`。
#   - 无 `+` → 改动已全部在 base 里（**merge 与 squash 两种合并方式都能识别**，
#     这正是它比 `git branch -d` 强的地方：-d 只认「已并入 HEAD/upstream」，
#     而 squash 合并后本地 main 通常还没 fetch，于是 -d 会误报未合并）；
#   - 有 `+` → 还有没合进去的提交 → **保留**（绝不静默删掉别人的活）。
# 所以 `-D` 只在我们自己已经证明过「无 `+`」之后才用，不是绕开安全检查。
# `--force`（对应「强拆 worktree」）才无条件 `-D`。
remove_workspace_branch() { # $1=name $2=src_path $3=branch $4=force(非空即强删)
  local name="$1" path="$2" branch="$3" force="${4:-}" base pending
  [ -n "$branch" ] || return 0
  git -C "$path" show-ref --verify --quiet "refs/heads/$branch" || return 0

  if [ -n "$force" ]; then
    if git -C "$path" branch -D "$branch" >/dev/null 2>&1; then
      printf '  %s✓ 已删除分支 %s（--force）%s\n' "$c_grn" "$branch" "$c_rst"
    else
      warn "$name: 强制删除分支 $branch 失败，已保留。"
    fi
    return 0
  fi

  base="$(toml_get "$name" base)"; [ -n "$base" ] || base="$(detect_base "$path")"
  # best-effort fetch：判定要对着**最新** base，否则刚合完的 PR 会被判成未合并。
  git -C "$path" fetch --quiet origin 2>/dev/null \
    || warn "$name: fetch 失败（离线？），分支判定用的是本地缓存的 $base"

  pending="$(git -C "$path" cherry "$base" "$branch" 2>/dev/null | grep -c '^+' || true)"
  if [ "$pending" = "0" ]; then
    if git -C "$path" branch -D "$branch" >/dev/null 2>&1; then
      printf '  %s✓ 已删除分支 %s（改动均在 %s 里）%s\n' "$c_grn" "$branch" "$base" "$c_rst"
    else
      warn "$name: 分支 $branch 删除失败（被别的 worktree 占用？），已保留。"
    fi
  else
    # 有意不返回非 0：worktree 已经拆了，分支也**没被**删掉，没有任何数据损失，
    # 因此不该让编排层（archive / pre-remove 钩子）据此中止删除本工作区。
    warn "$name: 分支 $branch 还有 $pending 个提交未并入 $base → 保留"
    warn "         （确认这些提交无价值后再跑：./wt cleanup --force）"
  fi
}

cmd_cleanup() {
  local force=""; [ "${1:-}" = "--force" ] && force="--force"
  [ -f "$STATE" ] || { info "无可清理内容"; return; }
  local kept; kept="$(mktemp)"       # 未成功拆除的行留下，保住跟踪
  local name path target branch
  while IFS=$'\t' read -r name path target branch; do
    [ -n "$name" ] || continue
    # 非 force：worktree 有未提交改动（含未跟踪新文件）→ 整条保留、不碰，
    # 也不跑 teardown——绝不毁掉尚未保存的工作及其 dev 数据。
    # （porcelain 为空 ⇔ 下面的 git worktree remove 一定成功；gitignore 掉的
    #   dev 生成物如 config/.installed/node_modules 不算，不会误挡。）
    if [ -z "$force" ] && [ -n "$(git -C "$target" status --porcelain 2>/dev/null)" ]; then
      warn "$name: 有未提交改动，未删除。确认后用 wt cleanup --force"
      printf '%s\t%s\t%s\t%s\n' "$name" "$path" "$target" "$branch" >> "$kept"
      continue
    fi
    # 确定要拆了 → 先回收该仓库 per-worktree 资源，再删 worktree。
    run_teardown "$target" "$name"
    if [ -n "$force" ]; then
      git -C "$path" worktree remove --force "$target" 2>/dev/null || rm -rf "$target"
    elif ! git -C "$path" worktree remove "$target" 2>/dev/null; then
      warn "$name: worktree 拆除失败，已保留。"
      printf '%s\t%s\t%s\t%s\n' "$name" "$path" "$target" "$branch" >> "$kept"
      continue
    fi
    git -C "$path" worktree prune 2>/dev/null || true
    # 分支跟在 worktree 后面清（worktree 还在时那个分支是 checkout 状态，删不掉）。
    remove_workspace_branch "$name" "$path" "$branch" "$force"
    printf '  %s✓ 已拆除 %s%s\n' "$c_grn" "$name" "$c_rst"
  done < "$STATE"
  if [ -s "$kept" ]; then
    mv "$kept" "$STATE"
    warn "仍有仓库未拆除，state 已保留。（archive hook 可据非 0 退出码中止删除）"
    return 1
  fi
  rm -f "$kept" "$STATE"
  rmdir "$REPOS_DIR" 2>/dev/null || true
}

sub="${1:-list}"; shift || true
case "$sub" in
  list)    cmd_list "$@" ;;
  add)     cmd_add "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  -h|--help|help) awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$0" ;;
  *) die "未知命令: ${sub}（wt help 查看用法）" ;;
esac
